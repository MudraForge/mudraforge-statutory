        "governingSection1961": "Section 206AA (20% missing PAN)",
        "governingSection2025": "Section 397(2) (20% missing PAN)"
      }
    },
    {
      "id": "GUARD_PROFESSIONAL_OR_NON_COMPETE_10_PERCENT",
      "field": "isProfessionalOrNonCompete",
      "operator": "EQ",
      "value": true,
      "onMatch": {
        "action": "OVERRIDE_RATE",
        "overrideRateBps": 1000,
        "governingSection1961": "Section 194J(1) (10% for Professional Services/Non-Compete)",
        "governingSection2025": "Section 393(1) Table 1 (10% for Professional Services)"
      }
    }
  ],
  "computation": {
    "archetype": "CLIFF_THRESHOLD",
    "thresholdPaisa": "3000000",
    "standardRateBps": 200,
