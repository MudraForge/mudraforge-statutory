{
  "$schema": "https://mudraforge.in/schemas/statutory-ast-v2.1.json",
  "sectionId": "ITA2025_SEC393",
  "version": "2.1.0",
  "title": "Tax Deduction at Source on Payment for Purchase of Goods (2025 Act)",
  "governingStatute": "Income-tax Act, 2025",
  "statutorySection": "Section 393(1), Table 1, Sl. No. 8(ii)",
  "successorStatute": "Income-tax Act, 2025",
  "successorSection": "Section 393(1), Table 1, Sl. No. 8(ii)",
  "successorTableItem": "TABLE_1_SL_NO_8_II_PURCHASE_OF_GOODS",
  "transitionalCutoverDate": "2026-04-01",
  "effectivePeriod": {
    "validFrom": "2026-04-01",
    "validTo": null
  },
  "triggerPolicy": {
    "type": "EARLIER_OF",
    "events": [
      "BOOK_CREDIT",
      "PAYMENT_DISBURSEMENT"
    ],
    "statutoryBasis": "Section 393(1) earlier of credit or payment"
  },
  "guards": [
    {
      "id": "GUARD_FOREIGN_IMPORT",
      "field": "isImportOfGoods",
      "operator": "EQ",
      "value": true,
      "onMatch": {
        "action": "HALT_EXEMPT",
        "disposition": "EXEMPT_IMPORT_OF_GOODS_FOREIGN_VENDOR",
        "reason": "Section 393 does not apply to import of goods from non-residents."
      }
    },
    {
      "id": "GUARD_MISSING_OR_INOPERATIVE_PAN",
      "field": "payee.isPanValid",
      "operator": "EQ",
      "value": false,
      "onMatch": {
        "action": "OVERRIDE_RATE",
        "overrideRateBps": 500,
        "governingSection1961": "Section 206AA(1) First Proviso",
        "governingSection2025": "Section 397(2)(b)(i)(C)"
      }
    }
  ],
  "computation": {
    "archetype": "EXCESS_OVER_THRESHOLD",
    "thresholdPaisa": "500000000",
    "standardRateBps": 10,
    "baseDetermination": "CUMULATIVE_TURNOVER_IN_FINANCIAL_YEAR"
  },
  "rounding": {
    "transactionLine": "COMMERCIAL_PAISA",
    "assessmentTotal": "INCOME_TAX_ACT_2025_SEC516"
  }
}