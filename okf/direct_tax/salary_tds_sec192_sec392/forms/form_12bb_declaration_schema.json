{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Form12BbEmployeeDeclarationSchema",
  "description": "Statutory declaration of claims by an employee for deduction of tax under Section 192 (Rule 26C of Income-tax Rules, 1962 / Section 392(4) of Income-tax Act, 2025)",
  "type": "object",
  "required": [
    "financialYear",
    "employeePan",
    "employeeName",
    "selectedRegime"
  ],
  "properties": {
    "financialYear": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}$",
      "description": "Financial year e.g. 2025-26"
    },
    "employeePan": {
      "type": "string",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
    },
    "employeeName": {
      "type": "string",
      "minLength": 1
    },
    "selectedRegime": {
      "type": "string",
      "enum": ["NEW_TAX_REGIME_115BAC", "OLD_TAX_REGIME"],
      "default": "NEW_TAX_REGIME_115BAC"
    },
    "houseRentAllowance": {
      "type": "object",
      "properties": {
        "annualRentPaidInr": { "type": "number", "minimum": 0 },
        "landlordName": { "type": "string" },
        "landlordPan": {
          "type": "string",
          "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
          "description": "Mandatory if annual rent exceeds INR 1,00,000 per CBDT Circular 08/2013"
        },
        "landlordAddress": { "type": "string" },
        "isMetroCity": { "type": "boolean", "default": false }
      }
    },
    "leaveTravelConcession": {
      "type": "object",
      "properties": {
        "amountClaimedInr": { "type": "number", "minimum": 0 },
        "evidenceDocumentRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "homeLoanInterestSec24": {
      "type": "object",
      "properties": {
        "interestPayableInr": { "type": "number", "minimum": 0, "maximum": 200000 },
        "lenderName": { "type": "string" },
        "lenderPan": { "type": "string" },
        "provisionalCertificateRef": { "type": "string" }
      }
    },
    "chapterSixADeductions": {
      "type": "object",
      "properties": {
        "section80C": { "type": "number", "minimum": 0, "maximum": 150000 },
        "section80CCC": { "type": "number", "minimum": 0 },
        "section80CCD1": { "type": "number", "minimum": 0 },
        "section80CCD1B": { "type": "number", "minimum": 0, "maximum": 50000 },
        "section80CCD2EmployerNps": { "type": "number", "minimum": 0 },
        "section80DHealthInsurance": { "type": "number", "minimum": 0, "maximum": 100000 },
        "section80EEducationLoan": { "type": "number", "minimum": 0 },
        "section80GDonations": { "type": "number", "minimum": 0 }
      }
    }
  }
}
