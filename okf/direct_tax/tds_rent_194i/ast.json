  "title": "TDS on Rent of Land, Building or Machinery",
  "governingStatute": "Income-tax Act, 1961",
  "statutorySection": "Section 194I",
  "successorStatute": "Income-tax Act, 2025",
  "successorSection": "Section 393(1), Table 1, Sl. No. 2",
  "successorTableItem": "TABLE_1_SL_NO_2_RENT",
  "transitionalCutoverDate": "2026-04-01",
  "effectivePeriod": {
    "validFrom": "1994-06-01",
    "validTo": null
  },
  "triggerPolicy": {
    "type": "EARLIER_OF",
    "events": [
      "BOOK_CREDIT",
      "PAYMENT_DISBURSEMENT"
