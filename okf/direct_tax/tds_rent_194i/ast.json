  "guards": [
    {
      "id": "GUARD_MISSING_PAN_206AA",
      "field": "payee.isPanValid",
      "operator": "EQ",
      "value": false,
      "onMatch": {
        "action": "OVERRIDE_RATE",
        "overrideRateBps": 2000,
        "governingSection1961": "Section 206AA (20% missing PAN)",
        "governingSection2025": "Section 397(2) (20% missing PAN)"
      }
    },
    {
      "id": "GUARD_LAND_BUILDING_10_PERCENT",
      "field": "isLandOrBuilding",
      "operator": "EQ",
      "value": true,
      "onMatch": {
        "action": "OVERRIDE_RATE",
        "overrideRateBps": 1000,
        "governingSection1961": "Section 194I(b) (10% for Land, Building, Furniture)",
        "governingSection2025": "Section 393(1)"
      }
    }
  ],
  "computation": {
    "archetype": "CLIFF_THRESHOLD",
    "thresholdPaisa": "24000000",
    "standardRateBps": 200,
    "baseDetermination": "ANNUAL_AGGREGATE"
  },
  "rounding": {
